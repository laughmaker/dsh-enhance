{
  "name": "dsh-enhance",
  "version": "0.3.3",
  "description": "DeepSeek Harness enhancements: Markdown theme for every renderer, select-text annotations with pins, a narrower sidebar, and startup defaults (maximized window, narrowest sidebar, colourful running marker). 中文：DSH 增强插件——Markdown 主题、划词批注、侧栏宽度、启动默认状态。",
  "type": "module",
  "main": "lib/index.js",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-resources",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.1 <0.3.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-bundle",
    "plugin",
    "markdown",
    "annotation"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "laughmaker",
  "scripts": {
    "build": "tsdown --config tsdown.config.mjs",
    "test": "vitest run tests",
    "prepublishOnly": "tsdown --config tsdown.config.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laughmaker/dsh-enhance.git"
  },
  "homepage": "https://github.com/laughmaker/dsh-enhance#readme",
  "bugs": {
    "url": "https://github.com/laughmaker/dsh-enhance/issues"
  },
  "devDependencies": {
    "tsdown": "^0.22.2",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
